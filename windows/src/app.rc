#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// The app icon (lens ring with "fwc"), generated by tools/make_icon.py. The lowest ID is the one
// Explorer shows for the exe.
1 ICON "app.ico"

// Person-segmentation model for the background blur (see ../models/README.md).
2 RCDATA "../models/selfie_segmenter.onnx"
